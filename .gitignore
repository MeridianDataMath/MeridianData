# generated by scripts/build-snapshot.mjs (published with the site by the Action, never committed)
data/
logs/
# the copy agent's folder keeps only what the site publishes; its key, config, control token, state, link request, logs
# and node modules stay on the machine that runs it, under whatever names a config gives them
agent/*
!agent/copy-agent.mjs
!agent/package.json
!agent/package-lock.json
!agent/config.example.json
# a second agent's folder beside the first, and key material anywhere
/agent-*/
*.key
*.pem
.env
.env.*
link-request*.json
# build-time tooling (package.json at the root: the card renderer)
node_modules/
# the card builder writes these into dist/ at deploy time; a local run (--dist .) may leave them here
/cards/
/a/
/p/
# OS / editor noise
Thumbs.db
.DS_Store
*.log
