// The site's timer (worker.js): starts the "Snapshot & deploy" workflow at minutes 14 and 44 of every hour.
// Deployed by .github/workflows/cron.yml when cron/ changes (or on demand); its secret DISPATCH_TOKEN is set in the
// Cloudflare dashboard once and kept across deploys. No route, no workers.dev address, no preview URLs: nothing can reach
// it from outside, it only runs on its schedule.
{
  "name": "meridiandatahub-cron",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["14,44 * * * *"] }
}
