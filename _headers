# Cloudflare Pages headers (ignored by GitHub Pages)
# Content-Security-Policy: scripts only from the site itself, plus index.html's one inline script (the /a/ and /p/ redirect)
# by its hash: recompute the sha256 whenever that script changes (tests/cards.test.mjs checks the two agree). The share
# pages under /a/ and /p/ need no inline code (js/share.js and css/app.css). connect-src lists every host the site
# calls, and also 'https:' because the phone-push (ntfy) server is the visitor's own choice: without it a self-hosted ntfy
# stops working. http://127.0.0.1 and http://localhost are the copy agent's control port and a local ntfy. Start-
# MeridianData.ps1 sends this same block, so a violation shows up on the local copy first. Keep one policy for /*: a
# second rule matching the same paths would be enforced as well.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-zMXcSgATXV8+13WjUqC01CHw+DnlZTY5tMFRGbRxGoY='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.meridian.xyz https://archive.meridian.xyz https://tradingview.meridian.xyz wss://ws.meridian.xyz https://api.predict.meridian.xyz https://gamma-api.polymarket.com https://clob.polymarket.com https://polygon-bor-rpc.publicnode.com https://1rpc.io https://rpc.mainnet.chain.robinhood.com https://api.frankfurter.dev https://ntfy.sh https: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
/data/*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# link-preview cards and the share pages behind /a/<address> and /p/<address> (rebuilt with every deploy; an image URL
# carries ?v=<hash of the card> so an unfurler that cached an old one fetches the new one)
/cards/*
  Cache-Control: public, max-age=1800
/a/*
  Cache-Control: public, max-age=300
/p/*
  Cache-Control: public, max-age=300
