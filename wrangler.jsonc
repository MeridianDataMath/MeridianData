// Cloudflare Worker with static assets — deployed by the GitHub Action (`wrangler deploy`).
// No Worker code: everything in dist/ is served as-is, _headers applies, unknown paths fall back to index.html.
// The site is served only on its custom domain (meridian.thedatahub.xyz, attached in the dashboard). wrangler treats a
// missing workers_dev / preview_urls as "turn them on" at every deploy, so both are switched off here explicitly: each
// deploy now keeps the *.workers.dev address and the per-version preview URLs disabled.
{
  "name": "meridiandatahub",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
