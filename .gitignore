# generated by scripts/build-snapshot.mjs (published with the site by the Action, never committed)
data/
logs/
# the copy agent's key, config, link request and node modules stay on the machine that runs it
agent/signer.key
agent/config.json
agent/link-request.json
agent/state.json
agent/logs/
agent/node_modules/
agent/package-lock.json
# build-time tooling (package.json at the root: the card renderer)
node_modules/
# the card builder writes these into dist/ at deploy time; a local run (--dist .) may leave them here
/cards/
/a/
/p/
# OS / editor noise
Thumbs.db
.DS_Store
*.log
